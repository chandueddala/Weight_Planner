# ============================================================================
# ENVIRONMENT CONFIGURATION FILE
# ============================================================================
#
# This is a template for the .env file. Copy this file to .env and fill in
# your actual values.
#
# IMPORTANT:
# - Never commit the .env file to version control
# - Keep your API keys secret and secure
# - Do not share your .env file with others
#
# ============================================================================

# ----------------------------------------------------------------------------
# OPENAI API CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------
#
# Get your API key from: https://platform.openai.com/account/api-keys
#
# Steps to get your API key:
# 1. Sign up or log in to OpenAI Platform
# 2. Navigate to API Keys section
# 3. Click "Create new secret key"
# 4. Copy the key (you won't see it again!)
# 5. Paste it below (replace the placeholder)
#
OPENAI_API_KEY=sk-proj-your-actual-openai-api-key-here

# ----------------------------------------------------------------------------
# OPENAI ORGANIZATION ID (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Only needed if you're part of multiple organizations
# Get from: https://platform.openai.com/account/org-settings
#
# OPENAI_ORG_ID=org-your-organization-id-here

# ----------------------------------------------------------------------------
# MODEL CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Override default models if needed
# Default models used:
# - GPT-4-turbo for weight summaries, exercise plans, and chat
# - GPT-3.5-turbo for meal annotations
#
# OPENAI_MODEL_GPT4=gpt-4-turbo
# OPENAI_MODEL_GPT35=gpt-3.5-turbo
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ----------------------------------------------------------------------------
# STREAMLIT CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Customize Streamlit server settings
#
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost
# STREAMLIT_SERVER_HEADLESS=true
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Customize application behavior
#
# APP_DEBUG=false
# APP_LOG_LEVEL=INFO
# APP_TIMEZONE=UTC

# ----------------------------------------------------------------------------
# VECTOR STORE CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Path to FAISS vector store (default: ./vector)
# Only change if you move the vector store to a different location
#
# VECTOR_STORE_PATH=./vector
# VECTOR_STORE_K=7

# ----------------------------------------------------------------------------
# DATA CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Paths to data files (defaults are usually fine)
#
# RECIPES_CSV_PATH=Calories/Recipes.csv
# IMAGES_PATH=images/

# ----------------------------------------------------------------------------
# API RATE LIMITING (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Set rate limits to control API usage and costs
#
# OPENAI_MAX_REQUESTS_PER_MINUTE=60
# OPENAI_MAX_TOKENS_PER_REQUEST=4000

# ----------------------------------------------------------------------------
# CACHING CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Enable/disable caching for better performance
#
# ENABLE_STREAMLIT_CACHE=true
# CACHE_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# SECURITY SETTINGS (OPTIONAL)
# ----------------------------------------------------------------------------
#
# Additional security configurations
#
# ENABLE_CORS=false
# ENABLE_XSRF_PROTECTION=true
# SESSION_TIMEOUT_MINUTES=60

# ============================================================================
# EXAMPLE CONFIGURATION FOR DEVELOPMENT
# ============================================================================
#
# Uncomment and modify these settings for local development:
#
# OPENAI_API_KEY=sk-proj-abc123def456ghi789jkl012mno345pqr678stu901vwx234yz
# APP_DEBUG=true
# APP_LOG_LEVEL=DEBUG
# STREAMLIT_SERVER_PORT=8501
# ENABLE_STREAMLIT_CACHE=true

# ============================================================================
# EXAMPLE CONFIGURATION FOR PRODUCTION
# ============================================================================
#
# Uncomment and modify these settings for production deployment:
#
# OPENAI_API_KEY=sk-proj-your-production-api-key-here
# APP_DEBUG=false
# APP_LOG_LEVEL=WARNING
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# ENABLE_CORS=true
# SESSION_TIMEOUT_MINUTES=30

# ============================================================================
# COST MANAGEMENT TIPS
# ============================================================================
#
# To minimize OpenAI API costs:
#
# 1. Set usage limits on your OpenAI account dashboard
# 2. Monitor your usage regularly at: https://platform.openai.com/usage
# 3. Use GPT-3.5-turbo for simpler tasks (cheaper than GPT-4)
# 4. Enable caching to reduce redundant API calls
# 5. Set max_tokens limits in code to control response lengths
#
# Estimated costs (as of 2025):
# - GPT-4-turbo: ~$0.01 per 1K input tokens, ~$0.03 per 1K output tokens
# - GPT-3.5-turbo: ~$0.0005 per 1K input tokens, ~$0.0015 per 1K output tokens
# - Embeddings: ~$0.0001 per 1K tokens
#
# Average cost per user session: $0.05 - $0.20
#
# ============================================================================
# TROUBLESHOOTING
# ============================================================================
#
# If you encounter issues:
#
# 1. "API key not found" error:
#    - Ensure .env file is in the project root directory
#    - Check that OPENAI_API_KEY is spelled correctly (no typos)
#    - Verify no extra spaces around the = sign
#    - Restart the application after editing .env
#
# 2. "Invalid API key" error:
#    - Verify the API key is correct (copy-paste from OpenAI dashboard)
#    - Check that the key hasn't been revoked
#    - Ensure you have credits available on your OpenAI account
#
# 3. Rate limit errors:
#    - Wait a few minutes before retrying
#    - Reduce the number of concurrent requests
#    - Upgrade your OpenAI plan if needed
#
# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
#
# ✅ DO:
# - Keep your .env file in .gitignore
# - Use different API keys for development and production
# - Rotate API keys periodically (every 90 days)
# - Set spending limits on your OpenAI account
# - Use environment-specific .env files (.env.dev, .env.prod)
#
# ❌ DON'T:
# - Never commit .env to Git
# - Never share your API key in screenshots or logs
# - Never hardcode API keys in source code
# - Never use production keys in development
# - Never share your .env file via email or chat
#
# ============================================================================
# GETTING HELP
# ============================================================================
