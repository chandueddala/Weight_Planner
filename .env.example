# ========================================
# AWS Configuration
# ========================================
AWS_PROFILE=default
AWS_REGION=us-east-2

# ========================================
# DynamoDB Tables
# ========================================
DDB_USERS_TABLE=Users
DDB_SESSIONS_TABLE=UserSessions
DDB_MESSAGES_TABLE=UserMessages

# ========================================
# Session Configuration
# ========================================
DEFAULT_SESSION_ID=default

# ========================================
# OpenAI Configuration
# ========================================
# Local development: use OPENAI_API_KEY
OPENAI_API_KEY=your-openai-api-key-here

# Production (Lambda with Secrets Manager): use OPENAI_SECRET_ID
# OPENAI_SECRET_ID=prod/openai/api-key

# Model configuration
MODEL_NAME=gpt-4-turbo

# ========================================
# Application Settings
# ========================================
# Default starting credits for new users
DEFAULT_STARTING_CREDITS=20

# Credit cost per RAG query
DEFAULT_CREDIT_COST=1

# Maximum conversation turns to keep in session state
MAX_SESSION_TURNS=6

# FAISS similarity score threshold (lower = more similar)
SIMILARITY_THRESHOLD=0.5
